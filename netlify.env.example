# ── Netlify Environment Variables Template ──────────────────────────────────
# Set in: Netlify Dashboard -> Site configuration -> Environment variables

# 1. Public Backend REST API URL (Render)
VITE_API_BASE_URL=https://<your-render-service>.onrender.com/api

# 2. Public Backend WebSocket URL (Render)
VITE_WS_BASE_URL=wss://<your-render-service>.onrender.com
