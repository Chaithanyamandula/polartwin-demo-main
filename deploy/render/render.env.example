# ── Render Environment Variables Template ───────────────────────────────────
# Configure these in: Render Dashboard -> Your Web Service -> Environment

# ── No Database Required ──────────────────────────────────────────────────
# The backend runs completely in-memory (RAM) with zero database setup.
# No PostgreSQL, no SQLite disk files, and no database configuration needed!

# JWT secret key for signing tokens (64-char random string):
JWT_SECRET=polartwin-production-super-secret-key-antarctica-2026-render

# Simulation tick speed (seconds):
SIMULATION_TICK_SECONDS=4

# Port (Render sets this dynamically to 10000, defaults to 8000):
PORT=8000

# Frontend origin for CORS security (enter your deployed Netlify URL):
# Note: Any *.netlify.app origin is already accepted automatically by the backend regex!
FRONTEND_ORIGIN=https://<your-site-name>.netlify.app
