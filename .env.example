# ──────────────────────────────────────────────────────────────────────────────
# POLARTWIN — Unified Environment Configuration Template
# Copy this file to .env and customize values as needed.
# NEVER commit your real .env to source control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Backend Configuration ───────────────────────────────────────────────────
# No database required — runs purely in-memory (RAM) with zero setup!

# JWT Secret (generate a strong key using: python -c "import secrets; print(secrets.token_hex(48))")
JWT_SECRET=polartwin-dev-secret-key-super-secure-antarctica-2026

ACCESS_TOKEN_EXPIRE_MINUTES=1440
SIMULATION_TICK_SECONDS=4
FRONTEND_ORIGIN=http://localhost:5173

# Optional Services
WEATHER_API_KEY=
LLM_API_KEY=
SENTRY_DSN=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── Frontend Configuration (Vite & Netlify) ─────────────────────────────────
# For Local Development:
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_BASE_URL=ws://localhost:8000

# For Production (When Backend is hosted on Render and Frontend on Netlify):
# Set these in Netlify Site Configuration -> Environment Variables:
# VITE_API_BASE_URL=https://<your-render-service>.onrender.com/api
# VITE_WS_BASE_URL=wss://<your-render-service>.onrender.com

